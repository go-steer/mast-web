"""Standalone mock backend for mast-web smoke testing.

Serves the endpoints mast-web's attach client hits during connect +
basic operation. The SSE event stream is fed from the shared
conformance fixtures under ``web/attach-core/conformance/fixtures/``,
so the same JSONL files that lock down the wire protocol under
``vitest`` also drive the smoke UI — one source of truth.

Zero dependencies beyond the Python 3 standard library; matches the
project convention of not adding dev-only Python packages.

Usage:
    dev/tools/mock-backend [--port 7778] [--fixture 001-happy-turn]
                           [--frame-delay-ms 150]

Query parameter ``?fixture=<name>`` on ``/sessions/{sid}/events``
overrides the default fixture per request, letting the operator flip
between happy-turn, cost-ceiling, latency, observer, and forward-
compat fixtures from the browser URL bar.

Everything is CORS-open (Access-Control-Allow-Origin: *) so the SPA
served from a different port (dev/tools/dev on :8000) can talk to
this without a proxy.

Not a substitute for a real backend — no state, no agent loop, no
persistence. Purpose: exercise the SPA's render + event handling +
sidebar wiring end-to-end without needing credentials or the actual
core-agent binary.
"""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

REPO_ROOT = pathlib.Path(__file__).resolve().parents[2]
FIXTURES_DIR = REPO_ROOT / "web" / "attach-core" / "conformance" / "fixtures"

# Canned session shape returned from GET /sessions. Kept minimal —
# just enough for the SPA to auto-select it and open an SSE stream.
MOCK_SESSION = {
    "app_name": "mast-web-mock",
    "user_id": "smoke@example.com",
    "session_id": "smoke-session",
    "has_event_log": True,
    "status": "active",
    "last_touched_at": "2026-07-20T12:00:00Z",
}

# Minimal per-session sidebar stubs. Values chosen so the sidebar
# panels populate to something visible (rather than blank / error).
STUB_STATUS = {
    "model": "mock-model-1.5",
    "provider": "mock",
    "turn_state": "idle",
    "context_pct": 8,
    "perm_mode": "prompt",
}
STUB_TOOLS = {
    "tools": [
        {"name": "fs_read", "description": "Read files"},
        {"name": "fs_write", "description": "Write files"},
        {"name": "bash_exec", "description": "Run shell commands"},
    ],
}
STUB_AGENTS = {
    "agents": [
        {"name": "researcher", "description": "Research + summarize"},
        {"name": "implementer", "description": "Write + edit code"},
    ],
}
STUB_USAGE = {
    "overall": {"tokens_in": 45, "tokens_out": 8, "cost_usd": 0.00012, "turns": 1},
    "per_model": {"mock-model-1.5": {"tokens_in": 45, "tokens_out": 8, "cost_usd": 0.00012, "turns": 1}},
    "per_turn": [],
}


def cors_headers() -> list[tuple[str, str]]:
    return [
        ("Access-Control-Allow-Origin", "*"),
        ("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS"),
        ("Access-Control-Allow-Headers", "Content-Type, Authorization, X-Attach-Token"),
        ("Access-Control-Max-Age", "3600"),
    ]


def load_fixture(name: str) -> list[dict]:
    """Read a JSONL fixture; return a list of frame dicts.

    Fixture names may include or omit the .jsonl extension. If the
    named fixture is missing, falls back to 001-happy-turn with a
    logged warning rather than 500-ing — the smoke UI is nicer to
    debug when it always renders *something*.
    """
    stem = name if not name.endswith(".jsonl") else name[: -len(".jsonl")]
    path = FIXTURES_DIR / f"{stem}.jsonl"
    if not path.exists():
        sys.stderr.write(
            f"mock-backend: fixture '{stem}.jsonl' not found; "
            f"falling back to 001-happy-turn\n"
        )
        path = FIXTURES_DIR / "001-happy-turn.jsonl"
    frames = []
    with path.open("r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            frames.append(json.loads(line))
    return frames


class Handler(BaseHTTPRequestHandler):
    # Server-scoped config populated in main() before serve_forever.
    default_fixture: str = "001-happy-turn"
    frame_delay_ms: int = 150

    # ─── Framing helpers ─────────────────────────────────────────────

    def _write_json(self, status: int, obj) -> None:
        body = json.dumps(obj).encode("utf-8")
        self.send_response(status)
        for k, v in cors_headers():
            self.send_header(k, v)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _write_empty(self, status: int = 204) -> None:
        self.send_response(status)
        for k, v in cors_headers():
            self.send_header(k, v)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def _write_error(self, status: int, msg: str) -> None:
        body = msg.encode("utf-8")
        self.send_response(status)
        for k, v in cors_headers():
            self.send_header(k, v)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    # ─── Method dispatchers ──────────────────────────────────────────

    def do_OPTIONS(self) -> None:  # noqa: N802 (BaseHTTPRequestHandler convention)
        self._write_empty(204)

    def do_GET(self) -> None:  # noqa: N802
        url = urlparse(self.path)
        path = url.path

        if path == "/sessions":
            self._write_json(200, {"sessions": [MOCK_SESSION]})
            return

        # SSE event stream — the interesting endpoint.
        # Match both /sessions/{sid}/events and the qualified form
        # /sessions/{app}/{sid}/events.
        parts = path.strip("/").split("/")
        if len(parts) >= 3 and parts[0] == "sessions" and parts[-1] == "events":
            fixture = self._fixture_from_query(url.query)
            self._stream_fixture_sse(fixture)
            return

        # Sidebar stubs. Match both qualified and shortcut forms.
        # /sessions/[<app>/]<sid>/<endpoint>
        if len(parts) >= 3 and parts[0] == "sessions":
            endpoint = parts[-1]
            if endpoint == "status":
                self._write_json(200, STUB_STATUS)
                return
            if endpoint == "tools":
                self._write_json(200, STUB_TOOLS)
                return
            if endpoint == "agents":
                self._write_json(200, STUB_AGENTS)
                return
            if endpoint == "usage":
                self._write_json(200, STUB_USAGE)
                return
            # /perms/stream — long-lived SSE that just idles. The
            # Prompter reconnect loop would otherwise thrash if we 404
            # on the endpoint; better to accept + emit nothing so the
            # SPA reports the perms channel as connected-but-quiet.
            if endpoint == "stream" and len(parts) >= 4 and parts[-2] == "perms":
                self._idle_sse()
                return

        if path == "/whoami":
            self._write_json(200, {
                "identity": "smoke@example.com",
                "admin": False,
                "source": "mock",
            })
            return

        if path == "/.well-known/agent-card.json":
            self._write_json(200, {
                "name": "mast-web-mock",
                "description": "Standalone smoke backend for mast-web",
                "version": "0.0.0-mock",
            })
            return

        # /peers is optional; empty list is a safe default.
        if path == "/peers":
            self._write_json(200, {"peers": []})
            return

        # Fallback: return a friendly stub rather than 404 so the SPA
        # doesn't error on optional read endpoints (memory, skills,
        # mcp, pricing, perms) we haven't explicitly modeled.
        if path.startswith("/sessions/") and len(parts) >= 3:
            self._write_json(200, {})
            return

        self._write_error(404, f"mock-backend: unknown GET {path}\n")

    def do_POST(self) -> None:  # noqa: N802
        url = urlparse(self.path)
        path = url.path
        # Drain the request body so the client's write doesn't hang;
        # we ignore the contents for smoke purposes.
        length = int(self.headers.get("Content-Length") or 0)
        if length > 0:
            _ = self.rfile.read(length)

        parts = path.strip("/").split("/")

        # POST /sessions — session-create. Returns a new triple.
        if path == "/sessions":
            self._write_json(201, {
                "app": MOCK_SESSION["app_name"],
                "user": MOCK_SESSION["user_id"],
                "sessionID": "smoke-session-2",
                "url": f"http://{self.headers.get('Host', 'localhost:7778')}/sessions/{MOCK_SESSION['app_name']}/smoke-session-2",
            })
            return

        # POST .../interrupt — accept with the "nothing in flight"
        # header so the Stop button flashes without an error.
        if len(parts) >= 3 and parts[0] == "sessions" and parts[-1] == "interrupt":
            self.send_response(200)
            for k, v in cors_headers():
                self.send_header(k, v)
            self.send_header("X-Interrupted", "nothing-in-flight")
            self.send_header("Content-Length", "0")
            self.end_headers()
            return

        # Everything else (inject / wake / perms/respond / perms/allow
        # / perms/deny / slash/*): accept as no-op.
        if len(parts) >= 3 and parts[0] == "sessions":
            self._write_json(200, {})
            return

        self._write_error(404, f"mock-backend: unknown POST {path}\n")

    def do_DELETE(self) -> None:  # noqa: N802
        # DELETE /sessions/{app}/{sid} — 204. Guard the bootstrap
        # default sid with 403 so the client's guard test path works.
        parts = self.path.strip("/").split("/")
        if len(parts) >= 3 and parts[0] == "sessions" and parts[-1] == "default":
            self._write_error(403, "cannot delete bootstrap default session\n")
            return
        if len(parts) >= 2 and parts[0] == "sessions":
            self._write_empty(204)
            return
        self._write_error(404, f"mock-backend: unknown DELETE {self.path}\n")

    # ─── SSE emitters ────────────────────────────────────────────────

    def _stream_fixture_sse(self, fixture_name: str) -> None:
        frames = load_fixture(fixture_name)
        self.send_response(200)
        for k, v in cors_headers():
            self.send_header(k, v)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "keep-alive")
        self.send_header("X-Accel-Buffering", "no")
        self.end_headers()
        try:
            for frame in frames:
                event_name = frame.get("event", "message")
                data = json.dumps(frame.get("data", {}))
                chunk = f"event: {event_name}\ndata: {data}\n\n".encode("utf-8")
                self.wfile.write(chunk)
                self.wfile.flush()
                time.sleep(self.frame_delay_ms / 1000.0)
            # After the fixture completes, hold the stream open with
            # periodic SSE comment keep-alives so the SPA doesn't
            # think we hung up. The operator can reload to replay.
            while True:
                self.wfile.write(b": keep-alive\n\n")
                self.wfile.flush()
                time.sleep(15)
        except (BrokenPipeError, ConnectionResetError):
            # Client disconnected; normal on reload / switch.
            return

    def _idle_sse(self) -> None:
        """Long-lived SSE that never emits payload — just keep-alives."""
        self.send_response(200)
        for k, v in cors_headers():
            self.send_header(k, v)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "keep-alive")
        self.end_headers()
        try:
            while True:
                self.wfile.write(b": keep-alive\n\n")
                self.wfile.flush()
                time.sleep(15)
        except (BrokenPipeError, ConnectionResetError):
            return

    # ─── Helpers ─────────────────────────────────────────────────────

    def _fixture_from_query(self, query: str) -> str:
        if not query:
            return self.default_fixture
        params = parse_qs(query)
        vals = params.get("fixture")
        if vals and vals[0]:
            return vals[0]
        return self.default_fixture

    def log_message(self, format: str, *args) -> None:  # noqa: A002 (BaseHTTPRequestHandler API)
        # Compact, single-line access log to stderr. BaseHTTPRequestHandler's
        # default is verbose and prefixes with timestamps that duplicate
        # the shell wrapper's output.
        sys.stderr.write("mock-backend %s - %s\n" % (self.address_string(), format % args))


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        description="Standalone mock backend for mast-web smoke testing.",
    )
    p.add_argument("--port", type=int, default=int(os.environ.get("MOCK_PORT", 7778)))
    p.add_argument(
        "--fixture",
        default=os.environ.get("MOCK_FIXTURE", "001-happy-turn"),
        help="Default fixture name (with or without .jsonl). Override per request "
        "via ?fixture=<name> on /sessions/{sid}/events.",
    )
    p.add_argument(
        "--frame-delay-ms",
        type=int,
        default=int(os.environ.get("MOCK_FRAME_DELAY_MS", 150)),
        help="Delay between SSE frames so the SPA has time to render each.",
    )
    return p.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)

    # Verify the default fixture is present before we bind — nicer
    # failure than a 404 the operator has to discover.
    default_path = FIXTURES_DIR / f"{args.fixture}.jsonl"
    if not default_path.exists():
        sys.stderr.write(
            f"mock-backend: default fixture not found at {default_path}\n"
            f"available fixtures:\n"
        )
        for f in sorted(FIXTURES_DIR.glob("*.jsonl")):
            sys.stderr.write(f"  - {f.stem}\n")
        return 2

    Handler.default_fixture = args.fixture
    Handler.frame_delay_ms = args.frame_delay_ms

    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    sys.stderr.write(
        f"▸ mast-web mock backend on http://localhost:{args.port} "
        f"(fixture: {args.fixture}, frame delay: {args.frame_delay_ms}ms)\n"
        f"  connect the SPA to http://localhost:{args.port} with no token\n"
    )
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        sys.stderr.write("\n▸ mast-web mock backend stopped\n")
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
