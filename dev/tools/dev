# Local development server for mast-web — serves web/ statically on
# :8000, without mock endpoints. Pair with a live core-agent / mast
# backend that the SPA points at via the setup modal.
#
# Thin wrapper around `mast-web-server --mode=static`. For smoke
# testing against a self-contained mock backend, use `make smoke`
# (which invokes dev/tools/mock-backend) instead.

set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

if ! command -v go >/dev/null 2>&1; then
  echo "dev: go not found on PATH" >&2
  echo "Install Go (matches the mast-web-server runtime dependency)." >&2
  exit 1
fi

PORT="${PORT:-8000}"

echo "▸ mast-web dev server on http://localhost:${PORT} (serving web/, no backend)"
echo "  Point the SPA at your running backend via the first-run setup modal."

exec go run ./cmd/mast-web-server \
  --mode=static \
  --web-dir=web \
  --listen=":${PORT}"
