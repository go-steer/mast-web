# Lint JS sources under web/ with ESLint.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"
ensure_node_deps

# eslint exits 0 on no matches when --no-error-on-unmatched-pattern is set.
exec npx --no-install eslint --no-error-on-unmatched-pattern 'web/**/*.js'
