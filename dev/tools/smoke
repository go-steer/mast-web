# Standalone smoke test — boots the mock backend and lets an operator
# visually confirm the SPA renders + handles events end-to-end without
# needing a real core-agent daemon or model credentials.
#
# The mock backend serves both the fake attach endpoints AND the SPA's
# static assets from web/ on the same port. Same-origin means no CORS,
# no cross-subdomain-cookie-auth issues in environments like Cloud
# Workstations / Codespaces / gitpod that gate each proxied port
# separately.
#
# Usage:
#     make smoke                   # via the Makefile
#     dev/tools/smoke              # direct
#     dev/tools/smoke --fixture 002-cost-ceiling-mid-turn
#
# Environment overrides:
#     MOCK_PORT             (default 7778)
#     MOCK_FIXTURE          (default 001-happy-turn)
#     MOCK_FRAME_DELAY_MS   (default 150)
#
# Operator flow:
#     1. Run this script.
#     2. Open http://localhost:7778 in a browser.
#     3. In the first-run setup modal, use `/` as the endpoint
#        (same-origin, which is what the mock serves) and leave the
#        token blank. Click Connect.
#     4. SPA streams the canned fixture (default: happy-turn) — real
#        markdown rendering, real tool-call chips, real per-turn footer.
#     5. Try scenarios by reloading with `?fixture=<name>` on the URL,
#        or restart the script with a different --fixture. Available
#        fixtures live under web/attach-core/conformance/fixtures/.
#     6. Ctrl-C tears down the mock cleanly.

set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

MOCK_PORT="${MOCK_PORT:-7778}"

if ! command -v python3 >/dev/null 2>&1; then
  echo "smoke: python3 not found on PATH" >&2
  echo "Install Python 3 (matches the same requirement as dev/tools/dev)." >&2
  exit 1
fi

# Run the mock in the foreground; its output goes straight to the
# terminal so operators see request logs live. Ctrl-C sends SIGINT
# to the Python process which exits cleanly via KeyboardInterrupt.
cat <<EOF
▸ mast-web smoke test starting
  URL:      http://localhost:${MOCK_PORT}
  Endpoint: /  (same-origin — enter this in the setup modal)
  Token:    (none — leave blank)

  Reload with ?fixture=<name> to switch scenarios. Available:
$(cd web/attach-core/conformance/fixtures && ls *.jsonl | sed 's/\.jsonl$//' | sed 's/^/    /')

  Ctrl-C to stop.
EOF

MOCK_PORT="$MOCK_PORT" exec ./dev/tools/mock-backend --port "$MOCK_PORT" "$@"
