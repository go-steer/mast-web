# Build the distributable static bundle into ./dist/.
#
# v0.1: vanilla JS — copy web/ verbatim into dist/. No bundling, no
# transpilation. Becomes a real build step (esbuild / vite / etc.) if we
# adopt TypeScript or a framework, per docs/web-design.md stack
# decisions.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

rm -rf dist
mkdir -p dist

if [[ -d web ]] && [[ -n "$(ls -A web 2>/dev/null)" ]]; then
  cp -R web/. dist/
  echo "▸ built dist/ from web/ ($(find dist -type f | wc -l | tr -d ' ') files)"
else
  echo "▸ web/ is empty — dist/ created but no assets copied (pre-phase-A state)"
fi
