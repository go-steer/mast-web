# Thin wrapper around `mast-web-server --mode=mock` for local smoke
# testing. Serves both the fake attach endpoints AND the SPA static
# assets on the same port — same-origin, no CORS, works through cloud
# IDE port proxies (Cloud Workstations / Codespaces / gitpod).
#
# Usage:
#     dev/tools/mock-backend                         # 001-happy-turn on :7778
#     dev/tools/mock-backend --fixture 002-cost-ceiling-mid-turn
#     PORT=8888 dev/tools/mock-backend               # override port
#
# All flags pass through to mast-web-server; run
# `dev/tools/mock-backend --help` for the full flag list.

set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

if ! command -v go >/dev/null 2>&1; then
  echo "mock-backend: go not found on PATH" >&2
  echo "Install Go (matches the mast-web-server runtime dependency)." >&2
  exit 1
fi

PORT="${PORT:-${MOCK_PORT:-7778}}"

exec go run ./cmd/mast-web-server \
  --mode=mock \
  --web-dir=web \
  --listen=":${PORT}" \
  "$@"
