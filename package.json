{
  "name": "mast-web",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "description": "Operator-facing web UI for mast and any attach-mode-compatible core-agent variant.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/go-steer/mast-web.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "./dev/tools/dev",
    "build": "./dev/tools/build",
    "test": "./dev/tools/test-unit",
    "lint": "./dev/tools/lint-js && ./dev/tools/lint-css && ./dev/tools/verify-html",
    "format": "prettier --write 'web/**/*.{js,css,html,json}'",
    "ci": "./dev/tools/ci"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "htmlhint": "^1.2.0",
    "prettier": "^3.4.2",
    "stylelint": "^16.13.0",
    "stylelint-config-standard": "^36.0.1",
    "vitest": "^2.1.8",
    "jsdom": "^25.0.1"
  }
}
