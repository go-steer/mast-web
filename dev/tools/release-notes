#
# release-notes <tag> — print the GitHub Release body for a tag.
#
# Usage:  dev/tools/release-notes v0.4.0
#
# The body is that tag's section of CHANGELOG.md, followed by the
# artifact boilerplate every release needs (what to download, where the
# checksum is, which image was pushed). Called by
# .github/workflows/release.yml; runnable by hand to see exactly what a
# tag would publish before pushing it.
#
# Why a script and not a heredoc in the workflow: the previous version
# was an indented multi-line string inside release.yml, and YAML block
# indentation rode along into the body — four leading spaces, which
# markdown renders as a code block. Every release from v0.2.0 to v0.3.0
# has its description in a grey box for that reason. Text destined for
# a renderer belongs somewhere it can be read back before it ships.
#
# A tag with no changelog section is not an error: it prints the
# boilerplate alone and says why on stderr. Re-publishing an old tag
# through workflow_dispatch is the case that needs this, and failing
# the release over a missing section would be the wrong trade.

set -euo pipefail
. "$(dirname "$0")/common.sh"

cd "$(repo_root)"

CHANGELOG="CHANGELOG.md"
REPO_URL="https://github.com/go-steer/mast-web"

tag="${1:-}"
if [[ -z "$tag" ]]; then
  echo "usage: dev/tools/release-notes <tag>" >&2
  exit 2
fi

# CHANGELOG.md headings are `## [0.4.0] - 2026-09-15`; tags are v-prefixed.
version="${tag#v}"

section=""
if [[ -f "$CHANGELOG" ]]; then
  # Print from the matching heading up to (not including) the next
  # `## ` heading. The link-reference definitions at the foot of the
  # file are dropped — they resolve against the file, not against a
  # release body.
  section="$(
    awk -v want="## [${version}]" '
      index($0, want) == 1 { inside = 1; next }
      inside && /^## / { exit }
      inside { print }
    ' "$CHANGELOG" | grep -v '^\[.*\]: http' || true
  )"
fi

# Strip leading and trailing blank lines without disturbing the interior.
section="$(printf '%s\n' "$section" | sed -e '/./,$!d' | tac | sed -e '/./,$!d' | tac)"

# CHANGELOG.md links to sibling files by relative path, which is right in
# the file and wrong in a release body: GitHub renders release
# descriptions outside any file's directory, so `](docs/x.md)` 404s.
# Point them at this tag's tree, not at main — the release body should
# describe the code that shipped, not whatever main says later.
section="$(printf '%s\n' "$section" |
  sed -E "s@\]\((docs/|deploy/|dev/|web/|smoke/|cmd/)@](${REPO_URL}/blob/${tag}/\1@g")"

if [[ -z "$section" ]]; then
  echo "release-notes: no '## [${version}]' section in ${CHANGELOG}; publishing boilerplate only" >&2
else
  # The rule separates the notes from the boilerplate. With no notes
  # there is nothing to separate, and a body opening on a horizontal
  # rule looks like a rendering accident.
  printf '%s\n\n---\n\n' "$section"
fi

cat <<EOF
## Artifacts

- **\`mast-web-${tag}.tar.gz\`** — the built \`dist/\`, and the canonical artifact
  for downstream agent binaries (\`core-agent\`, \`mast\`) to fetch and embed via
  \`go:embed\`. SHA256 in the companion \`.sha256\` file.
- **\`ghcr.io/go-steer/mast-web:${tag}\`** — multi-arch (\`linux/amd64\`,
  \`linux/arm64\`) distroless image of \`mast-web-server\`, which serves the SPA
  and is both the standalone mock and the hosted backend-for-frontend.

Full changelog: [\`CHANGELOG.md\`](https://github.com/go-steer/mast-web/blob/${tag}/CHANGELOG.md).
See [\`docs/web-design.md\`](https://github.com/go-steer/mast-web/blob/${tag}/docs/web-design.md)
for how the embedding works, and [\`deploy/k8s/\`](https://github.com/go-steer/mast-web/tree/${tag}/deploy/k8s)
for the Kubernetes manifests.
EOF
