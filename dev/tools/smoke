# Standalone smoke test — SPA + mock backend on one port. No real
# core-agent daemon, no credentials, no network. Purpose: exercise
# the SPA's render + event handling end-to-end without external
# dependencies.
#
# Usage:
#     make smoke                   # via the Makefile
#     dev/tools/smoke              # direct
#     dev/tools/smoke --fixture 002-cost-ceiling-mid-turn
#
# Environment overrides (also settable as flags):
#     MOCK_PORT             (default 7778)
#     MOCK_FIXTURE          (default 001-happy-turn)
#     MOCK_FRAME_DELAY_MS   (default 150)
#
# Operator flow:
#     1. Run this script.
#     2. Open http://localhost:7778 in a browser.
#     3. In the first-run setup modal, use `/` as the endpoint (same
#        origin — the mock serves both the SPA and the fake attach
#        endpoints on the same port). Leave the token blank.
#     4. SPA streams the canned fixture — real markdown, tool-call
#        chips, per-turn footer.
#     5. Reload with ?fixture=<name> to switch scenarios.
#     6. Ctrl-C stops the mock cleanly.

set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

MOCK_PORT="${MOCK_PORT:-7778}"

cat <<EOF
▸ mast-web smoke test starting
  URL:      http://localhost:${MOCK_PORT}
  Endpoint: /  (same-origin — enter this in the setup modal)
  Token:    (none — leave blank)

  Reload with ?fixture=<name> to switch scenarios. Available:
$(cd web/attach-core/conformance/fixtures && ls *.jsonl | sed 's/\.jsonl$//' | sed 's/^/    /')

  Ctrl-C to stop.
EOF

MOCK_PORT="$MOCK_PORT" exec ./dev/tools/mock-backend "$@"
