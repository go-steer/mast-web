# Verify formatting of web sources via `prettier --check`.
# Run `npx prettier --write 'web/**/*.{js,css,html}'` to fix locally.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"
ensure_node_deps

# --no-error-on-unmatched-pattern keeps this passing on an empty web/ tree
# during the scaffolding phase before phase A lands.
exec npx --no-install prettier --check --no-error-on-unmatched-pattern \
  'web/**/*.{js,css,html,json}'
