# Verify all Go source files are gofmt-clean.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

bad=$(gofmt -l cmd internal 2>/dev/null || true)
if [[ -n "$bad" ]]; then
  echo "✗ go files not gofmt-clean:" >&2
  echo "$bad" >&2
  echo "Run 'gofmt -w cmd internal' to fix." >&2
  exit 1
fi
echo "✓ all Go files gofmt-clean"
